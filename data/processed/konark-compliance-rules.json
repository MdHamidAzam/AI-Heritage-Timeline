  "claimRules": [
    {
      "id": "rule-001",
      "rule": "A current official webpage must not automatically become a historical event.",
      "enforced": true
    },
    {
      "id": "rule-002",
      "rule": "A conservation action must not automatically imply a quantified reduction in damage.",
      "enforced": true
    },
    {
      "id": "rule-003",
      "rule": "A modern photograph must not automatically prove when historical damage occurred.",
      "enforced": true
    },
    {
      "id": "rule-004",
      "rule": "A textual damage description must not automatically become an exact image or 3D coordinate.",
      "enforced": true
    },
    {
      "id": "rule-005",
      "rule": "AI-generated reconstruction must never be labelled as original historical geometry.",
      "enforced": true
    },
    {
      "id": "rule-006",
      "rule": "Severity values require a documented scoring methodology.",
      "enforced": true
    },
    {
      "id": "rule-007",
      "rule": "Visitor numbers are contextual risk information and do not independently prove physical damage.",
      "enforced": true
    },
    {
      "id": "rule-008",
      "rule": "Unverified 3D geometry must be labelled as non-authoritative.",
      "enforced": true
    }
  ],

