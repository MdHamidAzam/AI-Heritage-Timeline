  "annotationTypes": [
    {
      "id": "component",
      "name": "Architectural Component",
      "purpose": "Identify a documented architectural component.",
      "geometryType": [
        "polygon",
        "bounding_box",
        "point"
      ]
    },
    {
      "id": "damage",
      "name": "Damage Region",
      "purpose": "Mark a physically documented damaged or deteriorated region.",
      "geometryType": [
        "polygon",
        "bounding_box",
        "point"
      ],
      "requiredEvidence": true
    },
    {
      "id": "restricted_zone",
      "name": "Restricted / Regulated Zone",
      "purpose": "Represent officially documented protection or access-management zones.",
      "geometryType": [
        "polygon",
        "circle",
        "point"
      ],
      "requiredEvidence": true
    },
    {
      "id": "evidence_region",
      "name": "Evidence Region",
      "purpose": "Link a visible image or spatial region to its documentary evidence.",
      "geometryType": [
        "polygon",
        "bounding_box",
        "point"
      ],
      "requiredEvidence": true
    }
  ],

