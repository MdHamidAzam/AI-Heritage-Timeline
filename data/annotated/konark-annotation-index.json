{
  "schemaVersion": "1.0.0",
  "datasetId": "konark-visual-annotations",
  "monumentId": "konark-sun-temple",
  "createdDate": "2026-09-08",

  "annotationPolicy": {
    "sourceImageRequired": true,
    "licenseRequired": true,
    "geometryMustBeObserved": true,
    "textOnlyDamageClaimCannotCreateGeometry": true,
    "historicalDamageCannotBeAssumedFromModernImage": true,
    "humanReviewRequired": true,
    "aiSuggestedAnnotationsRequireReview": true
  },

  "annotationClasses": [
    {
      "id": "component",
      "label": "Architectural Component",
      "examples": [
        "Vimana",
        "Jagamohana",
        "Natmandir",
        "Carved Wheels",
        "Stone Horses",
        "Plinth Reliefs"
      ]
    },
    {
      "id": "damage",
      "label": "Observed Damage / Deterioration",
      "examples": [
        "Cracking",
        "Stone Fragment Loss",
        "Stone Loosening",
        "Stone Fall",
        "Surface Erosion",
        "Vegetative Intrusion",
        "Water-related Evidence"
      ]
    },
    {
      "id": "environment",
      "label": "Environmental Condition",
      "examples": [
        "Standing Water",
        "Vegetation",
        "Wind/Sand Exposure Evidence"
      ]
    },
    {
      "id": "evidence",
      "label": "Evidence Region",
      "examples": [
        "Visible structural feature",
        "Visible conservation intervention",
        "Documentary reference region"
      ]
    }
  ],

