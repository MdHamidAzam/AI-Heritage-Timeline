  "annotationRecordTemplate": {
    "id": "annotation-unique-id",
    "assetId": "source-image-id",
    "annotationType": "component | damage | environment | evidence",
    "label": "canonical-label",
    "geometryType": "polygon | bounding_box | point",
    "geometry": null,
    "componentId": null,
    "damageEventId": null,
    "conditionId": null,
    "evidenceSourceId": null,
    "observedDate": null,
    "imageCaptureDate": null,
    "annotator": null,
    "reviewer": null,
    "reviewStatus": "pending",
    "confidence": null,
    "notes": null
  },

  "historicalLinkingRules": {
    "modernPhotographDoesNotProveHistoricalDamage": true,
    "historicalEventRequiresDocumentaryEvidence": true,
    "imageCanProvideVisualEvidenceWithoutProvingDateOfDamage": true,
    "historicalEventAndVisualObservationMustRemainSeparate": true
  },

  "qualityControl": {
    "minimumTwoStepReview": true,
    "reviewStates": [
      "pending",
      "accepted",
      "rejected",
      "needs_revision"
    ],
    "geometryValidationRequired": true,
    "labelValidationRequired": true,
    "sourceValidationRequired": true,
    "duplicateAnnotationCheck": true
  },

  "outputFormats": {
    "internal": "JSON",
    "computerVisionTraining": [
      "COCO",
      "YOLO",
      "GeoJSON"
    ],
    "exportOnlyAfterReview": true
  }
}